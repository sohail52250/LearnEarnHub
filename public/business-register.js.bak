
async function registerBusiness(){


let session =
await supabaseClient.auth.getSession();


let user=session.data.session?.user;


if(!user){

location.href="/login.html";
return;

}



let payload={

owner_id:user.id,

company_name:
company_name.value,

email:
email.value,

phone:
phone.value,

website:
website.value,

category:
category.value,

description:
description.value,

logo_url:
logo_url.value,

verified:false

};



let {error}=await supabaseClient
.from("business_profiles")
.insert(payload);



status.innerHTML =
error
?
"❌ "+error.message
:
"✅ Business registered successfully";


}


