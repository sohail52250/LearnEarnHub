let jobs=[];

async function loadJobs(){

const client=supabase.createClient(
SUPABASE_URL,
SUPABASE_ANON_KEY
);


const {data,error}=await client
.from("business_opportunities")
.select("*")
.eq("status","active")
.order("created_at",{ascending:false});


if(error){

document.getElementById("jobs").innerHTML=
"Unable to load business opportunities";

console.log(error);

return;

}


jobs=data || [];

displayJobs(jobs);

}



function displayJobs(list){

const box=document.getElementById("jobs");


if(!list.length){

box.innerHTML=
`
<div class="card">
<h2>No opportunities available yet</h2>
<p>Businesses will publish opportunities here.</p>
</div>
`;

return;

}


box.innerHTML=list.map(job=>`

<div class="card opportunity-card">

<h2>
🏢 ${job.title}
</h2>


<p>
${job.description || "No description provided"}
</p>


<p>
📂 Category:
${job.category || "General"}
</p>


<p>
📞 Contact:
${job.contact || "Not provided"}
</p>


<span class="verified-badge">
✔ Business Opportunity
</span>


<br><br>


<button onclick="contactBusiness('${job.contact || ""}')">
Contact Business
</button>


</div>

`).join("");

}



function searchJobs(){

const text=document
.getElementById("jobSearch")
.value
.toLowerCase();


displayJobs(

jobs.filter(j=>

(j.title || "")
.toLowerCase()
.includes(text)

)

);

}



function contactBusiness(contact){

if(!contact){

alert("Contact information not available");

return;

}


window.location.href=
"mailto:"+contact;

}



document.addEventListener(
"DOMContentLoaded",
loadJobs
);
