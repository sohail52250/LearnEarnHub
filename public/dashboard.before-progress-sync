<h2>Completed Lessons</h2>

<div id="lessons">
Loading...
</div>


</div>


<script>

let lessons=[

"word-basics",
"excel-basics",
"powerpoint-basics",
"html-basics",
"css-basics",
"email-basics"

];


let completed=0;


let output="";


lessons.forEach(function(item){

if(localStorage.getItem(item)=="completed"){

completed++;

output += "✅ "+item+"<br>";

}else{

output += "⬜ "+item+"<br>";

}

});


document.getElementById("lessons").innerHTML=output;


let percent=Math.round(
(completed/lessons.length)*100
);


document.getElementById("progress").style.width=
percent+"%";


document.getElementById("progress-text").innerHTML=
percent+"% Completed";


showUser();

</script>


