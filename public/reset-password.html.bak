<!DOCTYPE html>
<html>
<head>
<meta name="description" content="LearnEarnHub - Learn skills, find opportunities, earn online, and grow your career.">
<meta name="robots" content="index,follow">
<meta property="og:type" content="website">
<meta property="og:title" content="LearnEarnHub">
<meta property="og:description" content="Learn, Earn and Grow.">
<link rel="canonical" href="https://learn-earnhub.vercel.app/">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  padding:0;
  font-family:Arial,sans-serif;
  line-height:1.6;
  overflow-x:hidden;
}

img{
  max-width:100%;
  height:auto;
}

table{
  display:block;
  overflow-x:auto;
  width:100%;
}

.card{
  width:100%;
  max-width:100%;
}

@media (max-width:768px){
  body{
    font-size:16px;
  }

  h1{
    font-size:24px;
  }

  h2{
    font-size:20px;
  }
}

@media (max-width:480px){
  h1{
    font-size:20px;
  }

  h2{
    font-size:18px;
  }
}
</style>
<meta charset="utf-8">
<title>Reset Password</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="/supabase-config.js"></script>
<link rel="manifest" href="/manifest.json"><link rel="stylesheet" href="/components/leh-design-system.css">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="stylesheet" href="/assets/css/learn-earnhub-ui.css">
</head>
<body><div id="global-header"></div>

<h2>Set New Password</h2>

<p id="status">Checking recovery session...</p>

<input
  id="password"
  type="password"
  placeholder="New password"
/>

<button id="btn">
Update Password
</button>

<script>
const client = supabase.createClient(
  SUPABASE_URL,
  SUPABASE_ANON_KEY
);

async function ensureSession() {

  const hash = window.location.hash;

  if(hash.includes("access_token=")){

    const params = new URLSearchParams(
      hash.substring(1)
    );

    const access_token =
      params.get("access_token");

    const refresh_token =
      params.get("refresh_token");

    if(access_token && refresh_token){

      await client.auth.setSession({
        access_token,
        refresh_token
      });

    }
  }

  const { data } =
    await client.auth.getSession();

  if(data.session){
    document.getElementById("status")
      .innerText =
      "Recovery session detected";
    return true;
  }

  document.getElementById("status")
    .innerText =
    "Recovery session missing. Open a fresh reset email.";

  return false;
}

document
.getElementById("btn")
.addEventListener(
"click",
async () => {

  const ok = await ensureSession();

  if(!ok){
    alert(
      "Recovery session not found. Use a fresh reset email."
    );
    return;
  }

  const password =
    document.getElementById("password")
    .value;

  const { error } =
    await client.auth.updateUser({
      password
    });

  if(error){
    alert(error.message);
    return;
  }

  alert("Password updated successfully");

  window.location =
    "/login.html";
});

ensureSession();
</script>

<div id="global-footer"></div><script src="/global-layout.js"></script><script src="/js/role-guard.js"></script>
<script src="/assets/js/theme-helper.js"></script>
</body>
</html>
