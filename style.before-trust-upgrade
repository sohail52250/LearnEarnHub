/* Modern Mobile Navigation + Cards */

body{
font-family:Arial, sans-serif;
line-height:1.7;
font-size:18px;
margin:0;
padding:0;
background:#f5f9ff;
}

nav{
display:flex;
flex-wrap:wrap;
gap:12px;
justify-content:center;
padding:15px;
background:#2563eb;
}

nav a{
color:white;
text-decoration:none;
font-weight:bold;
padding:8px 12px;
border-radius:8px;
}

nav a:hover{
background:#1e40af;
}


.card{
background:white;
margin:18px auto;
padding:22px;
max-width:900px;
border-radius:18px;
box-shadow:0 5px 20px rgba(0,0,0,0.08);
}


h1{
color:#1d4ed8;
font-size:34px;
}


h2{
color:#2563eb;
}


button{
background:#16a34a;
color:white;
border:none;
padding:14px 22px;
margin:8px;
border-radius:12px;
font-size:18px;
cursor:pointer;
}


button:hover{
background:#15803d;
}


a{
color:#2563eb;
font-weight:bold;
}


footer{
text-align:center;
padding:25px;
background:#111827;
color:white;
}


@media(max-width:600px){

body{
font-size:20px;
}

nav{
display:block;
text-align:center;
}

nav a{
display:block;
margin:8px;
background:#1d4ed8;
}

.card{
margin:12px;
padding:18px;
}

h1{
font-size:30px;
}

button{
width:95%;
font-size:20px;
}

}


.menu-btn{
display:none;
}

@media(max-width:600px){

.menu-btn{
display:block;
width:95%;
margin:10px auto;
background:#7c3aed;
}

#mobileNav{
display:none;
}

}


/* Course Cards Upgrade */

.course-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
margin-top:20px;
}

.course-card{
background:white;
padding:25px;
border-radius:20px;
text-align:center;
box-shadow:0 5px 18px rgba(0,0,0,0.1);
transition:0.3s;
}

.course-card:hover{
transform:translateY(-5px);
}

.course-card .icon{
font-size:45px;
}

.course-card h3{
color:#2563eb;
}

.course-card a{
display:inline-block;
background:#2563eb;
color:white;
padding:12px 18px;
border-radius:10px;
text-decoration:none;
margin-top:10px;
}

.course-card a:hover{
background:#1e40af;
}

.hero{
background:linear-gradient(135deg,#2563eb,#16a34a);
color:white;
padding:35px;
border-radius:25px;
text-align:center;
}

.hero h1,
.hero h2{
color:white;
}

@media(max-width:600px){

.course-grid{
grid-template-columns:1fr;
}

.course-card{
padding:20px;
}

}


.language-box{
text-align:center;
}

.language-box button{
background:#7c3aed;
}


/* Lesson Search */

.search-box input{

width:90%;
padding:15px;
font-size:18px;
border-radius:12px;
border:2px solid #2563eb;
margin-bottom:15px;

}

.search-box p{

background:#f1f5f9;
padding:12px;
border-radius:10px;

}

