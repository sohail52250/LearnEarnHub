{

"openapi":"3.0.0",

"info":{

"title":"LearnEarnHub API",

"version":"1.0.0",

"description":
"LearnEarnHub Jobs, Opportunities, Learning and AI Matching API"

},


"servers":[

{
"url":"https://learn-earnhub.vercel.app"
}

],


"security":[

{
"ApiKeyAuth":[]
}

],


"components":{

"securitySchemes":{

"ApiKeyAuth":{

"type":"apiKey",

"name":"X-API-Key",

"in":"header"

}

}

},


"paths":{


"/api/analytics":{

"get":{

"summary":"Platform Analytics",

"parameters":[

{

"name":"action",

"in":"query",

"required":true,

"example":"stats"

}

],

"responses":{

"200":{

"description":"Analytics result"

}

}

}

},


"/api/global-opportunities":{

"get":{

"summary":"Global Opportunities",

"responses":{

"200":{

"description":"Opportunity list"

}

}

}

},


"/api/employer-posts":{

"get":{

"summary":"Employer Jobs",

"responses":{

"200":{

"description":"Job list"

}

}

}

}

}

}

